HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Exact HTTP(S) origin: no credentials, app path, query or fragment.
PUBLIC_ORIGIN=http://localhost:3000
AI_PROVIDER=demo
# Live provider settings are documented by the AI adapter. Keys stay server-side.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
MAX_ACTIVE_ROOMS=12
MAX_AI_CALLS=48
MAX_AI_TOKENS=120000
MAX_AI_COST_USD=0.50
MAX_DAILY_AI_COST_USD=5

# Server-enforced spatial sight; new matches only.
BEACON_VISION_RADIUS=360
BEACON_LIGHTS_VISION_RADIUS=110
BEACON_SABOTEUR_VISION_RADIUS=400

# Initial location for fresh tactical lobbies; hosts may select before starting.
LANTERN_MAP=beacon
# Available: beacon, stormbreak-annex. Saved rooms keep their selected map/version.
# hybrid (default): model council only; strategic: model intentions + council.
# Both use local navigation and the same reservation/budget path.
AI_STRATEGY=hybrid

# Optional defaults; hosts choose the final preset before starting a new room.
GAME_DEATH_POLICY=transfer
GAME_ABILITIES=false
# Lobby default: beacon (tactical), stormbreak-annex, storm-foundry, tidal-observatory, or beacon-illustrated.
GAME_MAP=beacon
