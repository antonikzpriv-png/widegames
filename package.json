{
  "name": "lantern-wake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A playable AI social deduction game aboard a storm beacon.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/main.mjs",
    "dev": "node --watch server/main.mjs",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node scripts/world-browser-check.mjs",
    "test:multiplayer-browser": "node scripts/multiplayer-browser-check.mjs",
    "test:features:browser": "node scripts/ghost-abilities-browser-check.mjs",
    "test:maps:browser": "node scripts/maps-captcha-browser-check.mjs",
    "test:tasks:browser": "node scripts/task-depth-browser-check.mjs",
    "test:replay:browser": "node scripts/spatial-replay-browser-check.mjs",
    "test:illustrated:browser": "node scripts/illustrated-maps-browser-check.mjs",
    "test:spectator:browser": "node scripts/spectator-browser-check.mjs",
    "perf:spectator": "node scripts/spectator-performance-check.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "puppeteer-core": "25.16.0"
  }
}
