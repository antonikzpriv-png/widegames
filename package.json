{
  "name": "lantern-wake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A playable AI social deduction game aboard a storm beacon.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/main.mjs",
    "dev": "node --watch server/main.mjs",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node scripts/world-browser-check.mjs",
    "test:beacon-browser": "node scripts/beacon-browser-check.mjs",
    "test:tactical-browser": "node scripts/tactical-browser-check.mjs",
    "test:features:browser": "node scripts/ghost-abilities-browser-check.mjs",
    "test:spatial-browser": "node scripts/spatial-replay-browser-check.mjs",
    "test:task-browser": "node scripts/task-progress-browser-check.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "puppeteer-core": "25.16.0"
  }
}
